# Since ".env" is gitignored, copy this file to ".env" and fill in real values.
# NEVER put secrets in this file — it is committed to version control.
# When adding variables, update the schema in "src/env.js" accordingly.

# Canonical MongoDB connection string — single source of truth.
# Prisma reads DATABASE_URL; the legacy driver (src/db) falls back to it,
# so only one URI is needed. Set MONGODB_URI too only to override the driver.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# Public site URL (used for newsletter verification links, metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: external email-sending webhook for newsletter verification mails
NEWSLETTER_SEND_API=""

# Set to 1 to skip env validation (e.g. Docker builds)
# SKIP_ENV_VALIDATION="1"
