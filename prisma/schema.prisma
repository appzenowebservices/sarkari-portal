generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

// NextAuth adapter models (JWT strategy still requires tables for adapter)
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  // legacy custom-session compat fields (optional)
  token     String?   @unique
  adminId   String?   @db.ObjectId
  expiresAt DateTime?
  createdAt DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique
  titleHi         String   @default("")
  titleEn         String   @default("")
  descriptionHi   String   @default("")
  descriptionEn   String   @default("")
  icon            String   @default("")
  color           String   @default("")
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  seoTitle        String   @default("")
  metaDescription String   @default("")
  focusKeyword    String   @default("")
  ogTitle         String   @default("")
  ogDescription   String   @default("")
  ogImage         String   @default("")
  canonicalUrl    String   @default("")
  robots          String   @default("index, follow")
  schemaType      String   @default("")
  createdAt       DateTime @default(now())

  @@map("categories")
}

model Service {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryIds   String[] @db.ObjectId
  titleHi       String   @default("")
  titleEn       String   @default("")
  url           String   @default("")
  descriptionHi String   @default("")
  descriptionEn String   @default("")
  tags          String   @default("")
  isFeatured    Boolean  @default(false)
  isNew         Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  clickCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([url])
  @@map("services")
}

model ServiceClick {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@index([serviceId])
  @@map("serviceClicks")
}

model Setting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String @default("")

  @@map("settings")
}

model Ad {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  variant         String    @default("")
  placement       String    @default("")
  titleHi         String    @default("")
  titleEn         String    @default("")
  descriptionHi   String    @default("")
  descriptionEn   String    @default("")
  linkUrl         String    @default("")
  imageUrl        String    @default("")
  buttonTextHi    String    @default("")
  buttonTextEn    String    @default("")
  bgColor         String    @default("")
  textColor       String    @default("")
  isPublished     Boolean   @default(false)
  publishAt       DateTime?
  expiresAt       DateTime?
  sortOrder       Int       @default(0)
  clickCount      Int       @default(0)
  impressionCount Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([placement, isPublished])
  @@map("ads")
}

model AdRequest {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String   @default("")
  email             String   @default("")
  phone             String   @default("")
  company           String   @default("")
  adType            String   @default("")
  preferredPlacement String  @default("")
  duration          String   @default("")
  budget            String   @default("")
  message           String   @default("")
  status            String   @default("RECEIVED")
  adminNotes        String   @default("")
  createdAt         DateTime @default(now())

  @@index([status])
  @@map("adRequests")
}

model AdType {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique
  nameHi        String   @default("")
  nameEn        String   @default("")
  descriptionHi String   @default("")
  descriptionEn String   @default("")
  basePrice     Float    @default(0)
  billingUnit   String   @default("")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("adTypes")
}

model Placement {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String   @unique
  nameHi     String   @default("")
  nameEn     String   @default("")
  multiplier Float    @default(1)
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("placements")
}

model DurationPlan {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  days            Int      @unique
  discountPercent Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("durationPlans")
}

model Advertisement {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  requestId           String   @unique
  advertiserName      String   @default("")
  contactPerson       String   @default("")
  email               String   @default("")
  mobile              String   @default("")
  websiteUrl          String   @default("")
  businessCategory    String   @default("")
  adTypeCode          String   @default("")
  placementCode       String   @default("")
  durationDays        Int      @default(0)
  startDate           String   @default("")
  targetPage          String   @default("")
  adTitle             String   @default("")
  shortDescription    String   @default("")
  ctaText             String   @default("")
  destinationUrl      String   @default("")
  creativeType        String   @default("")
  imageUrl            String   @default("")
  bannerImageUrl      String   @default("")
  logoUrl             String   @default("")
  altText             String   @default("")
  basePrice           Float    @default(0)
  placementMultiplier Float    @default(1)
  grossAmount         Float    @default(0)
  discountPercent     Float    @default(0)
  discountAmount      Float    @default(0)
  subtotal            Float    @default(0)
  gstPercent          Float    @default(0)
  gstAmount           Float    @default(0)
  totalAmount         Float    @default(0)
  status              String   @default("DRAFT")
  paymentStatus       String   @default("PENDING")
  paymentMethod       String   @default("")
  utrNumber           String   @default("")
  paymentScreenshot   String   @default("")
  paymentDate         String   @default("")
  paymentTime         String   @default("")
  adminReply          String   @default("")
  internalNotes       String   @default("")
  rejectionReason     String   @default("")
  approvedAt          String?
  scheduledAt         String?
  publishedAt         String?
  expiredAt           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@map("advertisements")
}

model Payment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  advertisementId String?  @db.ObjectId
  requestId       String   @default("")
  amount          Float    @default(0)
  method          String   @default("")
  utrNumber       String   @default("")
  screenshot      String   @default("")
  status          String   @default("PENDING")
  verifiedAt      String?
  verifiedBy      String   @default("")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@map("payments")
}

model PaymentSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  settingId          String   @unique @default("default")
  upiEnabled         Boolean  @default(false)
  upiId              String   @default("")
  payeeName          String   @default("")
  merchantName       String   @default("")
  paymentInstructions String  @default("")
  gstPercent         Float    @default(18)
  whatsappNumber     String   @default("")
  updatedAt          DateTime @updatedAt

  @@map("paymentSettings")
}

model CookieSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  settingId         String   @unique
  bannerEnabled     Boolean  @default(true)
  bannerTitle       String   @default("")
  bannerDescription String   @default("")
  position          String   @default("bottom")
  layout            String   @default("banner")
  policyVersion     String   @default("1.0")
  policyUrl         String   @default("")
  privacyPolicyUrl  String   @default("")
  updatedBy         String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("cookie_settings")
}

model CookieCategory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId     String   @default("")
  name           String   @default("")
  code           String   @unique
  description    String   @default("")
  required       Boolean  @default(false)
  defaultEnabled Boolean  @default(false)
  status         String   @default("active")
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("cookie_categories")
}

model CookieConsent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?  @db.ObjectId
  anonymousId     String   @default("")
  sessionId       String   @default("")
  consentStatus   String   @default("PENDING")
  preferences     Json     @default("{}")
  policyVersion   String   @default("1.0")
  consentMethod   String   @default("")
  consentTimestamp DateTime @default(now())
  consentUpdatedAt DateTime @updatedAt
  ipHash          String   @default("")
  userAgent       String   @default("")
  deviceType      String   @default("")
  browser         String   @default("")
  os              String   @default("")
  withdrawn       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([anonymousId])
  @@map("cookie_consents")
}

model CookieConsentHistory {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  consentId           String   @db.ObjectId
  userId              String?  @db.ObjectId
  anonymousId         String   @default("")
  previousPreferences Json     @default("{}")
  newPreferences      Json     @default("{}")
  action              String   @default("")
  policyVersion       String   @default("1.0")
  timestamp           DateTime @default(now())
  source              String   @default("")
  createdAt           DateTime @default(now())

  @@map("cookie_consent_history")
}

model NewsletterSubscriber {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  name              String    @default("")
  status            String    @default("pending")
  source            String    @default("website")
  preferences       Json      @default("{\"jobs\": true}")
  isVerified        Boolean   @default(false)
  verificationToken String?
  verifiedAt        DateTime?
  lastEmailAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("newsletter_subscribers")
}

model NewsletterSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("newsletter_settings")
}

model PrivacyRequest {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  requestId                 String    @unique
  userId                    String?
  fullName                  String    @default("")
  email                     String    @default("")
  mobile                    String    @default("")
  accountId                 String    @default("")
  requestType               String    @default("")
  subject                   String    @default("")
  description               String    @default("")
  requestedDataCategories   String[]  @default([])
  currentInformation        String    @default("")
  correctInformation        String    @default("")
  correctionReason          String    @default("")
  deletionScope             String[]  @default([])
  consentCategories         String[]  @default([])
  communicationPreferences  String[]  @default([])
  complaintCategory         String    @default("")
  incidentDate              String    @default("")
  relatedUrl                String    @default("")
  attachment                String    @default("")
  verificationMethod        String    @default("")
  verificationStatus        String    @default("")
  status                    String    @default("RECEIVED")
  priority                  String    @default("normal")
  assignedTo                String    @default("")
  internalNotes             String    @default("")
