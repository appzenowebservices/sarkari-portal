model JobTag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameHi    String   @default("")
  nameEn    String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

