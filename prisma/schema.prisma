}

model JobClick {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String   @db.ObjectId
  linkId    String?  @db.ObjectId
  linkType  String   @default("")
  source    String   @default("")
  device    String   @default("")
  browser   String   @default("")
  country   String   @default("")
  state     String   @default("")
  timestamp DateTime @default(now())

  @@index([jobId])
  @@map("job_clicks")
}

model JobView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String   @db.ObjectId
  source    String   @default("")
  device    String   @default("")
  browser   String   @default("")
  country   String   @default("")
  state     String   @default("")
  timestamp DateTime @default(now())

  @@index([jobId])
  @@map("job_views")
}

model JobHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String   @db.ObjectId
  changedBy   String   @default("")
  changedField String  @default("")
  oldValue    String   @default("")
  newValue    String   @default("")
  ip          String   @default("")
  timestamp   DateTime @default(now())

  @@index([jobId])
  @@map("job_history")
}

model JobSocialPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String    @db.ObjectId
  platform    String    @default("")
  postContent String    @default("")
  postUrl     String    @default("")
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([jobId])
  @@map("job_social_posts")
}

model Company {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  website        String   @default("")
  industry       String   @default("")
  size           String   @default("")
  location       String   @default("")
  recruiterName  String   @default("")
  recruiterEmail String   @default("")
  recruiterPhone String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("companies")
}
