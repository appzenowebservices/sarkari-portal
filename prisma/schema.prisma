  updatedAt                 DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@map("privacy_requests")
}

model ContactRequest {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  ticketId      String    @unique
  fullName      String    @default("")
  email         String    @default("")
  requestType   String    @default("")
  subject       String    @default("")
  message       String    @default("")
  attachment    String    @default("")
  status        String    @default("RECEIVED")
  priority      String    @default("normal")
  assignedTo    String    @default("")
  internalNotes String    @default("")
  reply         String    @default("")
  resolution    String    @default("")
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  completedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@map("contact_requests")
}

model JobCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique
  titleHi         String   @default("")
  titleEn         String   @default("")
  descriptionHi   String   @default("")
  descriptionEn   String   @default("")
  icon            String   @default("")
  color           String   @default("")
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  seoTitle        String   @default("")
  metaDescription String   @default("")
  focusKeyword    String   @default("")
  ogTitle         String   @default("")
  ogDescription   String   @default("")
  ogImage         String   @default("")
  canonicalUrl    String   @default("")
  robots          String   @default("index, follow")
  schemaType      String   @default("")
  createdAt       DateTime @default(now())

  @@map("job_categories")
}

model JobOrganization {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique
  nameHi        String   @default("")
  nameEn        String   @default("")
  abbreviation  String   @default("")
  website       String   @default("")
  descriptionHi String   @default("")
  descriptionEn String   @default("")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("job_organizations")
}

model JobLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  titleHi   String   @default("")
  titleEn   String   @default("")
  state     String   @default("")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("job_locations")
}

model JobQualification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  titleHi   String   @default("")
  titleEn   String   @default("")
  level     Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("job_qualifications")
}

model Job {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  slug                   String    @unique
  titleHi                String    @default("")
  titleEn                String    @default("")
  shortDescriptionHi     String    @default("")
  shortDescriptionEn     String    @default("")
  organizationId         String?   @db.ObjectId
  organizationNameHi     String    @default("")
  organizationNameEn     String    @default("")
  categoryId             String?   @db.ObjectId
  categoryNameHi         String    @default("")
  categoryNameEn         String    @default("")
  jobType                String    @default("government")
  sector                 String    @default("")
  state                  String    @default("")
  locationNames          String[]  @default([])
  applicationStartDate   String    @default("")
  applicationLastDate    String    @default("")
  notificationDate       String    @default("")
  totalVacancies         Int       @default(0)
  minimumQualification   String    @default("")
  maximumQualification   String    @default("")
  minimumAge             Int       @default(0)
  maximumAge             Int       @default(0)
  applicationFeeGeneral  Int       @default(0)
  applicationFeeOBC      Int       @default(0)
  applicationFeeSC       Int       @default(0)
  applicationFeeST       Int       @default(0)
  applyUrl               String    @default("")
  notificationUrl        String    @default("")
  status                 String    @default("draft")
  isFeatured             Boolean   @default(false)
  isUrgent               Boolean   @default(false)
  isActive               Boolean   @default(true)
  isGovernment           Boolean   @default(true)
  template               String    @default("government")
  blocks                 Json      @default("[]")
  tags                   String    @default("")
  seoTitle               String    @default("")
  metaDescription        String    @default("")
  focusKeyword           String    @default("")
  ogTitle                String    @default("")
  ogDescription          String    @default("")
  ogImage                String    @default("")
  canonicalUrl           String    @default("")
  robots                 String    @default("index, follow")
  schemaType             String    @default("JobPosting")
  viewCount              Int       @default(0)
  clickCount             Int       @default(0)
  applyClickCount        Int       @default(0)
  notificationClickCount Int       @default(0)
  websiteClickCount      Int       @default(0)
  minimumSalary          Int       @default(0)
  maximumSalary          Int       @default(0)
  payScale               String    @default("")
  sortOrder              Int       @default(0)
  // private-job fields
  companyNameEn          String    @default("")
  companyNameHi          String    @default("")
  companyLogo            String    @default("")
  companyWebsite         String    @default("")
  companyIndustry        String    @default("")
  companySize            String    @default("")
  companyLocation        String    @default("")
  recruiterName          String    @default("")
  recruiterEmail         String    @default("")
  recruiterPhone         String    @default("")
  employmentType         String    @default("")
  workMode               String    @default("")
  vacancies              Int       @default(0)
  experienceFrom         Int       @default(0)
  experienceTo           Int       @default(0)
  qualifications         String[]  @default([])
  salaryType             String    @default("")
  salaryMin              Int       @default(0)
  salaryMax              Int       @default(0)
  salaryPeriod           String    @default("")
  salaryNotDisclose      Boolean   @default(false)
  salaryNegotiable       Boolean   @default(false)
  incentives             String    @default("")
  benefits               String[]  @default([])
  applyMethod            String    @default("")
  externalUrl            String    @default("")
  applicationEmail       String    @default("")
  applicationInstructions String   @default("")
  walkInDate             String    @default("")
  walkInStartTime        String    @default("")
  walkInEndTime          String    @default("")
  walkInVenue            String    @default("")
  walkInAddress          String    @default("")
  walkInContactPerson    String    @default("")
  walkInContactNumber    String    @default("")
  walkInDocuments        String    @default("")
  walkInInstructions     String    @default("")
  genderPreference       String    @default("")
  ageFrom                Int       @default(0)
  ageTo                  Int       @default(0)
  languageRequirement    String    @default("")
  travelRequired         Boolean   @default(false)
  willingToRelocate      Boolean   @default(false)
  drivingLicenseRequired Boolean   @default(false)
  vehicleRequired        Boolean   @default(false)
  shiftType              String    @default("")
  workingHours           String    @default("")
  applicationLimit       Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  publishedAt            DateTime?
  expiredAt              DateTime?

  @@index([status])
  @@index([isActive])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([organizationId])
  @@map("jobs")
}

model JobVacancy {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String @db.ObjectId
  postNameHi  String @default("")
  postNameEn  String @default("")
  total       Int    @default(0)
  payScale    String @default("")
